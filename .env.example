# Local server
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini server-side only
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_EVALUATION_MODEL=gemini-3.6-flash
GEMINI_EVALUATION_FALLBACK_MODEL=gemini-3.5-flash
ALLOW_SANDBOX_EVALUATIONS=false

# Firebase Admin — choose one method
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=


# Paid test access / billing
# New users receive this many test credits when their entitlement is first initialized.
DEFAULT_FREE_TESTS=3
# Keep true only while testing the no-money payment simulator. Set false in production.
ALLOW_DEVELOPMENT_PAYMENTS=true
APP_URL=http://localhost:3000

# SSLCOMMERZ — leave blank until merchant credentials are available
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Browser
VITE_USE_MOCKS=false
VITE_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
VITE_GEMINI_LIVE_VOICE=Kore
VITE_GEMINI_EVALUATION_MODEL=gemini-3.6-flash
VITE_APP_URL=http://localhost:3000

# Firebase Web Client
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FORCE_LONG_POLLING=false

# Vercel production example (set in Vercel Project Settings, not in Git)
# VITE_APP_URL=https://YOUR-PROJECT.vercel.app
# ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
