{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:client",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/session/create",
      "destination": "/api/session-create"
    },
    {
      "source": "/api/session/mint",
      "destination": "/api/session-mint"
    },
    {
      "source": "/api/session/:path*",
      "destination": "/api/index?path=session/:path*"
    },
    {
      "source": "/api/evaluations/generate",
      "destination": "/api/evaluation-generate"
    },
    {
      "source": "/api/feedback/voice",
      "destination": "/api/feedback-voice"
    },
    {
      "source": "/api/evaluations/:path*",
      "destination": "/api/index?path=evaluations/:path*"
    },
    {
      "source": "/api/privacy/:path*",
      "destination": "/api/index?path=privacy/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index?path=admin/:path*"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/onboarding",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/practice/setup",
      "destination": "/index.html"
    },
    {
      "source": "/practice/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/results/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/history",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/readiness.ts": {
      "maxDuration": 10
    },
    "api/session-create.ts": {
      "maxDuration": 30
    },
    "api/session-mint.ts": {
      "maxDuration": 20
    },
    "api/evaluation-generate.ts": {
      "maxDuration": 60
    },
    "api/feedback-voice.ts": {
      "maxDuration": 60
    }
  }
}
